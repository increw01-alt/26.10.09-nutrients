# 로컬에서 수집 스크립트를 실행할 때 사용 (cp config/.env.example .env 후 값 입력)
# GitHub Actions 에서는 Settings > Secrets and variables > Actions 에 같은 이름으로 등록하세요.

# 식품안전나라 Open API 키 (건강기능식품 품목제조신고 C003) — https://www.foodsafetykorea.go.kr/api/openApiInfo.do
FOODSAFETY_API_KEY=
# 최신 신고분부터 거꾸로 수집할 최대 행 수 (0 = 전체, 전체는 20분 이상 소요)
FOODSAFETY_MAX_ROWS=15000

# 공공데이터포털(data.go.kr) 일반 인증키 — 의약품 정보(e약은요 DrbEasyDrugInfoService · 의약품 제품 허가정보 DrugPrdtPrmsnInfoService06) 활용신청 후 사용
DATA_GO_KR_KEY=
# 한 번 실행에서 허용할 의약품 API 호출 수 (개발계정 일일 1,000건 기준, 기본 900)
DRUG_API_BUDGET=900
# 한 번 실행에서 허용할 시간(초). 넘으면 받은 것까지 저장하고 종료 (기본 780)
DRUG_TIME_BUDGET=780

# 네이버 뉴스 검색 API (선택) — https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 쿠팡 파트너스 Open API (선택) — 파트너스 > 링크 생성 > API
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=supplenote

# 배포 도메인 (sitemap·canonical 생성에 사용, 비우면 assets/js/config.js 의 url 사용)
SITE_URL=
